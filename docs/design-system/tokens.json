{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Fieldwork design tokens — the single platform-agnostic source of truth. Compiled to CSS variables (web) and a TypeScript theme (React Native). Edit here; do not hand-edit generated platform files.",
  "color": {
    "brand": {
      "primary":      { "value": "#0A84FF", "type": "color", "comment": "Primary actions, active states" },
      "primaryHover": { "value": "#0060DF", "type": "color" },
      "onPrimary":    { "value": "#FFFFFF", "type": "color" }
    },
    "neutral": {
      "0":    { "value": "#FFFFFF", "type": "color" },
      "50":   { "value": "#F7F8FA", "type": "color" },
      "100":  { "value": "#EEF0F3", "type": "color" },
      "200":  { "value": "#E2E5EA", "type": "color" },
      "300":  { "value": "#C9CDD6", "type": "color" },
      "400":  { "value": "#A4AAB6", "type": "color" },
      "500":  { "value": "#7C828E", "type": "color" },
      "600":  { "value": "#5A606B", "type": "color" },
      "700":  { "value": "#3E434C", "type": "color" },
      "800":  { "value": "#272A30", "type": "color" },
      "900":  { "value": "#16181C", "type": "color" },
      "1000": { "value": "#0B0C0E", "type": "color" }
    },
    "semantic": {
      "success": { "value": "#34C759", "type": "color", "comment": "Paid, completed, on-track" },
      "warning": { "value": "#FF9F0A", "type": "color", "comment": "Running late, attention needed" },
      "danger":  { "value": "#FF3B30", "type": "color", "comment": "Overdue, failed, destructive" },
      "info":    { "value": "#5E5CE6", "type": "color", "comment": "Neutral system notice" }
    }
  },
  "font": {
    "family": {
      "system": { "value": "-apple-system, SF Pro, Roboto, Segoe UI, system-ui, sans-serif", "type": "fontFamily" },
      "mono":   { "value": "SF Mono, ui-monospace, Menlo, monospace", "type": "fontFamily", "comment": "Monetary alignment, IDs" }
    },
    "weight": {
      "regular":  { "value": "400", "type": "fontWeight" },
      "medium":   { "value": "500", "type": "fontWeight" },
      "semibold": { "value": "600", "type": "fontWeight" },
      "bold":     { "value": "700", "type": "fontWeight" }
    },
    "scale": {
      "display":  { "size": 34, "lineHeight": 41, "weight": "700", "type": "typography" },
      "title1":   { "size": 28, "lineHeight": 34, "weight": "700", "type": "typography" },
      "title2":   { "size": 22, "lineHeight": 28, "weight": "600", "type": "typography" },
      "headline": { "size": 17, "lineHeight": 22, "weight": "600", "type": "typography" },
      "body":     { "size": 17, "lineHeight": 22, "weight": "400", "type": "typography" },
      "callout":  { "size": 16, "lineHeight": 21, "weight": "400", "type": "typography" },
      "subhead":  { "size": 15, "lineHeight": 20, "weight": "400", "type": "typography" },
      "footnote": { "size": 13, "lineHeight": 18, "weight": "400", "type": "typography" },
      "caption":  { "size": 12, "lineHeight": 16, "weight": "400", "type": "typography" }
    }
  },
  "space": {
    "0": { "value": 0,  "type": "dimension" },
    "1": { "value": 4,  "type": "dimension" },
    "2": { "value": 8,  "type": "dimension" },
    "3": { "value": 12, "type": "dimension" },
    "4": { "value": 16, "type": "dimension" },
    "5": { "value": 20, "type": "dimension" },
    "6": { "value": 24, "type": "dimension" },
    "8": { "value": 32, "type": "dimension" },
    "10": { "value": 40, "type": "dimension" },
    "12": { "value": 48, "type": "dimension" },
    "16": { "value": 64, "type": "dimension" }
  },
  "radius": {
    "sm":   { "value": 8,   "type": "dimension" },
    "md":   { "value": 12,  "type": "dimension" },
    "lg":   { "value": 16,  "type": "dimension" },
    "full": { "value": 999, "type": "dimension" }
  },
  "size": {
    "touchTargetMin": { "value": 44, "type": "dimension", "comment": "Never go below this for interactive elements" }
  },
  "elevation": {
    "raised":  { "value": "0 1px 2px rgba(11,12,14,0.06), 0 1px 3px rgba(11,12,14,0.10)", "type": "shadow" },
    "overlay": { "value": "0 8px 24px rgba(11,12,14,0.14)", "type": "shadow", "comment": "Sheets, popovers" }
  },
  "motion": {
    "duration": {
      "fast":     { "value": 200, "type": "duration" },
      "standard": { "value": 280, "type": "duration" },
      "slow":     { "value": 360, "type": "duration" }
    },
    "easing": {
      "spring":   { "value": "cubic-bezier(0.32, 0.72, 0, 1)", "type": "cubicBezier", "comment": "iOS-like physical feel" },
      "standard": { "value": "cubic-bezier(0.4, 0.0, 0.2, 1)", "type": "cubicBezier" }
    }
  }
}
